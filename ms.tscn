[sub_resource type="GDScript" id="GDScript_2pj7l"]
resource_name = "Player.gd"
script/source = "extends CharacterBody2D

@onready var timer = $\"../FloorTimer\"
var timeout = 0.25
var can_jump

const SPEED = 100.0
const JUMP_VELOCITY = -175.0
const WALL_PUSHBACK = 800.0

var startTime = 500
var timeLeft = startTime
#self.position = 41, -4
var respawnPosition = self.position

var acceleration = 1000

func _physics_process(delta: float) -> void:
	var direction := Input.get_axis(\"ui_left\", \"ui_right\")
	var wall_jump: bool = false
	var canWallJump: bool = true
	var canMove: bool = true
	if is_on_floor():
		can_jump = true
		timer.start(timeout)
	

	#Handle movement
	#if Input.is_action_pressed(\"ui_left\"):
		#velocity.x = move_toward(velocity.x, -SPEED, delta * acceleration)
	#elif Input.is_action_pressed(\"ui_right\"):
		#velocity.x = move_toward(velocity.x, SPEED, delta * acceleration)
		#
	#if Input.is_action_just_released(\"ui_right\") or Input.is_action_just_released(\"ui_left\"):
		#velocity.x = 0
	#if Input.is_action_pressed(\"ui_right\") and Input.is_action_pressed(\"ui_left\"):
		#velocity.x = 0
	
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta

	# Handle jump.
	if Input.is_action_pressed(\"ui_up\") and can_jump:
		velocity.y = JUMP_VELOCITY
	
	#Wall jump
	#elif Input.is_action_pressed(\"ui_up\") and is_on_wall() and canWallJump:
		#wall_jump = true
		#canWallJump = false
		#velocity.y = JUMP_VELOCITY * 2.5
		#velocity.x += 200 * -direction
	#if not is_on_wall():
		#canWallJump = true
		
	if is_on_wall():
		var wall_normal = get_wall_normal()
		
		# Prüfen, auf welcher Seite die Wand liegt
		#if wall_normal.x > 0:
			#print(\"Wand ist links\", wall_normal)
		#elif wall_normal.x < 0:
			#print(\"Wand ist rechts\", wall_normal[0])
			
		# Beispiel: Von der Wand abspringen (Wall-Jump)
		if Input.is_action_just_pressed(\"ui_up\"):
			wall_jump = true
			velocity.y = JUMP_VELOCITY * 2
			velocity.x = wall_normal.x * WALL_PUSHBACK
			print(velocity.x)
			
		

	# Get the input direction and handle the movement/deceleration.
	# As good practice, you should replace UI actions with custom gameplay actions.
	if direction and not wall_jump:
		velocity.x = direction * SPEED
		
	elif not wall_jump:
		velocity.x = move_toward(velocity.x, 0, SPEED)

	move_and_slide()
	
func _process(delta: float) -> void:
	timeLeft -= delta
	
	#$CanvasLayer/Label.text = \"Time left: \" + str(timeLeft)
	$\"../CanvasLayer/Label\".text = \"Time left: \" + str(int(timeLeft))
	if timeLeft < 0:
		self.position = respawnPosition;
		timeLeft = startTime
	
	


func _on_area_2d_area_entered(area: Area2D) -> void:
	if area.is_in_group(\"Checkpoint\"):
		$\"../CanvasLayer/Label2\".text = \"Checkpoint reached\"
		print(\"help\")
		respawnPosition = self.position;
	if area.is_in_group(\"Killzone\"):
		self.position = respawnPosition


func _on_floor_timer_timeout() -> void:
	can_jump = false
	
"

